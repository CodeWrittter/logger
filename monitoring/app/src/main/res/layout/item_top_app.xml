<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/text_rank"
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textColor="@color/monitor_on_surface_low"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/img_app_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_app_icon"
        android:backgroundTint="@color/color_calls"
        android:scaleType="centerInside"
        android:padding="6dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WhatsApp"
            android:textColor="@color/monitor_on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="80"
            app:indicatorColor="@color/color_calls"
            app:trackColor="#2A2A2A"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_app_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:text="1h 27m"
        android:textColor="@color/monitor_on_surface"
        android:textSize="13sp" />

</LinearLayout>
